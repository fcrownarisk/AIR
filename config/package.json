{
  "name": "aircraft-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Headless 6-DOF flight dynamics sandbox in TypeScript. Zero runtime dependencies.",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
